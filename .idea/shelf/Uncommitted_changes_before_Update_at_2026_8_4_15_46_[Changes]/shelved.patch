+package net.wanho.fitai.infra.auth.helper;
+
+import cn.dev33.satoken.session.SaSession;
+import cn.hutool.core.util.ObjectUtil;
+import net.wanho.fitai.infra.auth.model.LoginUser;
+
+public class AdminLoginHelper {
+
+    public static LoginUser getLoginUser() {
+        return (LoginUser) StpKit.ADMIN.getSession().get(SaSession.USER);
+    }
+
+    public static Long getUserId() {
+        LoginUser loginUser = getLoginUser();
+        return ObjectUtil.isNull(loginUser) ? null : loginUser.getUserId();
+    }
+
+    public static String getUsername() {
+        LoginUser loginUser = getLoginUser();
+        return ObjectUtil.isNull(loginUser) ? null : loginUser.getUserName();
+    }
+
+    public static String getNickname() {
+        LoginUser loginUser = getLoginUser();
+        return ObjectUtil.isNull(loginUser) ? null : loginUser.getNickName();
+    }
+
+    public static String getDeptName() {
+        LoginUser loginUser = getLoginUser();
+        return ObjectUtil.isNull(loginUser) ? null : loginUser.getDeptName();
+    }
+}
