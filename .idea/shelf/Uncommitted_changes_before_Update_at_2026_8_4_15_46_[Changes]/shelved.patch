+package net.wanho.fitai.modules.auth.service.impl;
+
+import cn.dev33.satoken.session.SaSession;
+import cn.hutool.core.util.ObjectUtil;
+import cn.hutool.core.util.StrUtil;
+import cn.hutool.crypto.digest.BCrypt;
+import lombok.RequiredArgsConstructor;
+import net.wanho.fitai.infra.auth.constant.CommonConstant;
+import net.wanho.fitai.infra.auth.helper.StpKit;
+import net.wanho.fitai.infra.auth.model.LoginUser;
+import net.wanho.fitai.infra.exception.CustomException;
+import net.wanho.fitai.infra.util.AddressUtil;
+import net.wanho.fitai.infra.util.ServletUtil;
+import net.wanho.fitai.modules.auth.dto.AdminLoginDTO;
+import net.wanho.fitai.modules.auth.service.AdminAuthServiceI;
+import net.wanho.fitai.modules.auth.vo.AdminLoginVO;
+import net.wanho.fitai.modules.system.code.SystemCode;
+import net.wanho.fitai.modules.system.mapper.SysDeptMapper;
+import net.wanho.fitai.modules.system.model.po.SysDept;
+import net.wanho.fitai.modules.system.model.po.SysUser;
+import net.wanho.fitai.modules.system.service.SysLoginLogServiceI;
+import net.wanho.fitai.modules.system.service.SysUserServiceI;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.time.LocalDateTime;
+
+@Service
+@RequiredArgsConstructor
+public class AdminAuthServiceImpl implements AdminAuthServiceI {
+
+    private final SysUserServiceI sysUserService;
+    private final SysDeptMapper sysDeptMapper;
+    private final SysLoginLogServiceI loginLogService;
+
+    @Override
+    @Transactional(rollbackFor = Exception.class)
+    public AdminLoginVO login(AdminLoginDTO loginDto) {
+
+        SysUser sysUser = sysUserService.getByUserName(loginDto.getUsername());
+
+        if(ObjectUtil.isNull(sysUser)){
+            loginLogService.recordLoginLog(sysUser.getUserName(),"admin","admin","0",SystemCode.USER_NOT_FOUND.msg());
+            throw new CustomException(SystemCode.USER_NOT_FOUND);
+        }
+
+        if(!BCrypt.checkpw(loginDto.getPassword(),sysUser.getPassword())){
+            loginLogService.recordLoginLog(sysUser.getUserName(),"admin","admin","0",SystemCode.PASSWORD_ERROR.msg());
+            throw new CustomException(SystemCode.PASSWORD_ERROR);
+        }
+
+        if(sysUser.getStatus().equals(CommonConstant.STATUS_DISABLED)){
+            loginLogService.recordLoginLog(sysUser.getUserName(),"admin","admin","0",SystemCode.USER_DISABLED.msg());
+            throw new CustomException(SystemCode.USER_DISABLED);
+        }
+
+        // 登录
+        StpKit.ADMIN.login(sysUser.getUserId());
+
+        // 登录session中保存其它信息
+        StpKit.ADMIN.getSession().set(SaSession.USER,buildLoginUser(sysUser));
+
+        // 登录后令牌
+        String token= StpKit.ADMIN.getTokenValue();
+
+        // 更新最新登录ip和登录日期
+        updateLoginInfo(sysUser);
+
+        // 保存登录日志
+        loginLogService.recordLoginLog(sysUser.getUserName(),"admin","admin","1","登录成功");
+
+        // 构建对象返回
+        return buildUserInfo(token,sysUser);
+    }
+
+    private LoginUser buildLoginUser(SysUser sysUser) {
+
+        SysDept sysDept = sysDeptMapper.selectById(sysUser.getDeptId());
+
+        LoginUser loginUser = new LoginUser();
+        loginUser.setUserId(sysUser.getUserId());
+        loginUser.setUserName(sysUser.getUserName());
+        loginUser.setNickName(sysUser.getNickName());
+        loginUser.setDeptId(sysUser.getDeptId());
+        if(ObjectUtil.isNotNull(sysDept) && StrUtil.isNotEmpty(sysDept.getDeptName())){
+            loginUser.setDeptName(sysDept.getDeptName());
+        }
+        if(sysUser.getUserId().equals(CommonConstant.SUPER_ADMIN_ID)){
+            loginUser.setRoles(sysUserService.getAllRoleKeys());
+            loginUser.setPermissions(sysUserService.getAllPerms());
+        }else{
+            loginUser.setRoles(sysUserService.getRoleKeysByUserId(sysUser.getUserId()));
+            loginUser.setPermissions(sysUserService.getPermsByUserId(sysUser.getUserId()));
+        }
+        return loginUser;
+    }
+
+    private void updateLoginInfo(SysUser sysUser) {
+        SysUser updateUser = new SysUser();
+        updateUser.setUserId(sysUser.getUserId());
+        updateUser.setLoginIp(AddressUtil.getClientIP(ServletUtil.getRequest()));
+        updateUser.setLoginDate(LocalDateTime.now());
+        sysUserService.updateById(updateUser);
+    }
+
+    private AdminLoginVO buildUserInfo(String token, SysUser user) {
+        AdminLoginVO adminLoginVO = new AdminLoginVO();
+        adminLoginVO.setToken(token);
+        adminLoginVO.setUserId(user.getUserId());
+        adminLoginVO.setUsername(user.getUserName());
+        adminLoginVO.setNickname(user.getNickName());
+        adminLoginVO.setAvatar(user.getAvatar());
+        if(user.getUserId().equals(CommonConstant.SUPER_ADMIN_ID)){
+            adminLoginVO.setRoles(sysUserService.getAllRoleKeys());
+            adminLoginVO.setPermissions(sysUserService.getAllPerms());
+        }else{
+            adminLoginVO.setRoles(sysUserService.getRoleKeysByUserId(user.getUserId()));
+            adminLoginVO.setPermissions(sysUserService.getPermsByUserId(user.getUserId()));
+        }
+        return adminLoginVO;
+    }
+
+    @Override
+    public AdminLoginVO getCurrentUserInfo() {
+        return null;
+    }
+}
