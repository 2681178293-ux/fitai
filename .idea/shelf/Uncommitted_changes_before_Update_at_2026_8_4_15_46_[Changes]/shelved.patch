+package net.wanho.fitai.modules.auth.controller.admin;
+
+import io.swagger.v3.oas.annotations.Operation;
+import io.swagger.v3.oas.annotations.tags.Tag;
+import jakarta.validation.Valid;
+import lombok.RequiredArgsConstructor;
+import net.wanho.fitai.infra.auth.helper.AdminLoginHelper;
+import net.wanho.fitai.infra.auth.helper.StpKit;
+import net.wanho.fitai.infra.auth.model.LoginUser;
+import net.wanho.fitai.infra.result.AjaxResult;
+import net.wanho.fitai.modules.auth.dto.AdminLoginDTO;
+import net.wanho.fitai.modules.auth.service.AdminAuthServiceI;
+import net.wanho.fitai.modules.auth.vo.AdminLoginVO;
+import org.springframework.web.bind.annotation.*;
+
+@RestController
+@RequestMapping("/admin")
+@Tag(name = "管理员认证")
+@RequiredArgsConstructor
+public class AdminAuthController {
+
+    private final AdminAuthServiceI adminAuthService;
+
+    @PostMapping("/login")
+    @Operation(summary = "管理员登录")
+    public AjaxResult<AdminLoginVO> login(@RequestBody @Valid AdminLoginDTO loginDto) {
+        AdminLoginVO loginVO = adminAuthService.login(loginDto);
+        LoginUser loginUser = AdminLoginHelper.getLoginUser();
+        System.out.println(loginUser);
+        return AjaxResult.success(loginVO);
+    }
+
+    @GetMapping("/info")
+    @Operation(summary = "获取管理员信息")
+    public AjaxResult<AdminLoginVO> getInfo() {
+        return AjaxResult.success(adminAuthService.getCurrentUserInfo());
+    }
+
+    @PostMapping("/logout")
+    @Operation(summary = "管理员登出")
+    public AjaxResult<Void> logout() {
+        StpKit.ADMIN.logout();
+        return AjaxResult.success();
+    }
+}
